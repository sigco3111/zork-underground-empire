runtime/
release/
releases/
*.zip

# Local review artifacts and hosting state
qa/
screenshots/
.netlify/
playwright-report/
test-results/

# Local configuration, credentials, and logs
.env
.env.*
!.env.example
*.log
.DS_Store
Thumbs.db
