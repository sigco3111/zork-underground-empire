# Dependencies and generated builds.
# node_modules/ and dist/ are both git-ignored: dist/ is rebuilt in CI by the
# GitHub Pages workflow (.github/workflows/pages.yml), so we do not commit it.
node_modules/
dist/
coverage/
*.tsbuildinfo

